{
  "name": "@codex-autorunner/web-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/generate-spa-routes.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "test": "vitest run",
    "web:test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "isomorphic-dompurify": "^4.5.0",
    "marked": "^18.1.0"
  }
}
